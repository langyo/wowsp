{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // "node" for the *.test.ts files that read publicDir fixtures off disk
    // (mapNames.test.ts) — app code keeps ignoring the node globals.
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@wowsp/shared_ui": ["./src"],
      "@wowsp/shared_ui/*": ["./src/*"],
      "@shaders/*": ["./.generated/shaders/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "src/**/*.vue"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
