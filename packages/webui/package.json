{
  "name": "@wowsp/webui",
  "version": "0.6.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build-titlebar": "esbuild scripts/tauri-titlebar.ts --bundle --outfile=src/res/tauri-titlebar.js --format=iife --target=es2020",
    "preview": "vite preview",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@celestia-island/hikari": "^0.55.246",
    "@lucide/vue": "^1",
    "@msgpack/msgpack": "^3.1.3",
    "@tauri-apps/api": "^2",
    "@vue/devtools-api": "^8",
    "@wowsp/holo": "workspace:*",
    "html-to-image": "^1.11.13",
    "mediabunny": "^1",
    "pinia": "^4",
    "three": "^0.186",
    "vue": "^3",
    "vue-i18n": "^11",
    "vue-router": "^5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6",
    "@vitejs/plugin-vue-jsx": "^5",
    "@vue/test-utils": "^2",
    "esbuild": "^0.28",
    "happy-dom": "^21",
    "highlight.js": "11.12.0",
    "sass": "^1",
    "typescript": "^7",
    "vite": "^8",
    "vitest": "^5"
  }
}
