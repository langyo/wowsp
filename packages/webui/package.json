{
  "name": "@wowsp/webui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build-titlebar": "esbuild scripts/tauri-titlebar.ts --bundle --outfile=src/res/tauri-titlebar.js --format=iife --target=es2020",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.tsx --fix",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@celestia-island/hikari": "workspace:*",
    "@lucide/vue": "^1.38.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^14.4.0",
    "@wowsp/holo": "workspace:*",
    "echarts": "^6.1.0",
    "pinia": "^4.0.3",
    "three": "^0.185.1",
    "uuid": "^14.0.2",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/test-utils": "^2.5.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.12.0",
    "sass": "^1.103.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
