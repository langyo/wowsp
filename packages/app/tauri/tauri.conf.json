{
  "productName": "WoWSP",
  "version": "0.1.0",
  "identifier": "com.langyo.wowsp",
  "build": {
    "beforeBuildCommand": "pnpm --filter @wowsp/webui build",
    "beforeDevCommand": "pnpm --filter @wowsp/webui dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../../dist/webui"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/128x128.png",
      "icons/64x64.png",
      "icons/32x32.png",
      "icons/icon.icns"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "template": "installer/installer.nsi",
        "displayLanguageSelector": true,
        "languages": ["SimpChinese", "English"]
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WoWSP",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "minimizable": true,
        "maximizable": true,
        "closable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://asset.localhost https://asset.localhost; connect-src 'self' ws://localhost:* http://localhost:* https://localhost:* http://asset.localhost https://asset.localhost https://api.worldofwarships.* https://vortex.worldofwarships.* https://github.com https://*.githubusercontent.com https://api.github.com https://api.ipapi.co; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://asset.localhost https://asset.localhost; font-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/langyo/wowsp/releases/latest/download/latest.json",
        "https://ghp.ci/https://github.com/langyo/wowsp/releases/latest/download/latest.json",
        "https://gh-proxy.com/https://github.com/langyo/wowsp/releases/latest/download/latest.json",
        "https://ghfast.top/https://github.com/langyo/wowsp/releases/latest/download/latest.json",
        "https://ghproxy.net/https://github.com/langyo/wowsp/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1RUU1Q0M1NzY4NEE3RkQKUldUOXA0UjJ4Vnp1MVpWanBZbXZJTG4xZ2x1KzNWcUJtU20vZXJ4YkR1MWlYbmNCa3VjRHU0NUIK"
    }
  }
}
