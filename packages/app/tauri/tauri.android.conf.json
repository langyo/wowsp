{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WoWSP",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "minimizable": true,
        "maximizable": true,
        "closable": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$CACHE/**",
          "$LOCALDATA/WoWSP/**",
          "$DATA/WoWSP/wallpapers/**",
          "$DATA/WoWSP/stamps/**"
        ]
      }
    }
  }
}
