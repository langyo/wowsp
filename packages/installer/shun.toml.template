# ── Published artifacts ────────────────────────────────────────────────────
# `--variant lite` / `--variant webview2` map onto these; the shipped
# wowsp-flavor.txt markers ride the payloads themselves (the app updater
# picks -lite regardless, this is diagnostics + the wizard's identity line).

[[variant]]
name = "lite"
payload = "payload-lite"

[[variant]]
name = "webview2"
payload = "payload-webview2"
