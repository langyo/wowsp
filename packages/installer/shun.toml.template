# WoWSP installer manifest — consumed by the shun CLI (`shun build`).
# Requires shun >= 0.6.30 (the install-location rule system: the default
# drive-root and non-empty refusals, the declarative `dir-rules` table
# below, and the relocation lane it triggers — fresh installs only for
# the refusals; v0.6.31 additionally arms the swap-safety guards the
# pinned SHUN_TAG builds with — dir-rules probe one level below the
# target (the shared-games-root install shape), the swap refuses a
# directory holding files shun never delivered, and swapped-out
# backups are spared unless purely shun-owned; no manifest key of
# ours involved, the behavior rides the pin; v0.6.29 minimum for the
# `[shell] silent-progress`
# passive window — the visible auto-update — and the shell parking its
# CWD off the install target; v0.6.28 minimum for the silent upgrade
# to retry its directory swap over a lock survivor and degrade to an
# in-place merge — the 0.6.1 → 0.6.2 stranding; v0.6.26 minimum for
# dir-less silent runs to upgrade the registered install in place;
# v0.6.25 minimum for the headless shortcut presence refresh).
#
# This file is a TEMPLATE: scripts/build_installers.py renders it into the
# staging tree (substituting __WOWSP_VERSION__ with the workspace version)
# next to the staged payloads and license documents, then invokes
# `shun build --manifest <stage>/shun.toml --variant lite|webview2` inside
# a shun checkout (see the script and packages/installer/README.md).
#
# Schema: shun's configuration guide (celestia-island/shun
# docs/en/guides/configuration.md). Everything the installer does is
# declared here — WoWSP ships no custom installer shell anymore.

# Standalone manifest shape (consumed by `shun build`; see shun's
# docs/en/guides/configuration.md): product identity is flat.
product = "WoWSP"
version = "__WOWSP_VERSION__"
publisher = "langyo"
# Caption-bar / window icon source, staged beside this manifest.
logo = "logo.webp"

# Each published artifact is one variant; the base payload exists only so
# `shun config` has a default (every build pins --variant).
payload = "payload-lite"

# The silent lane renders its passive progress window: an auto-update
# spawned by ANY build's updater (the handoff only ever passes
# `--silent --dir`) shows "installing WoWSP <version>…" on its own, so
# nobody launches the old build into the directory mid-swap. No pages,
# no clicks; stdout unchanged; window-less sessions stay console-only.
[shell]
silent-progress = true

# The complete flavor carries the Evergreen offline runtime under its
# payload's webview2/ subtree: on a machine the WebView2 loader rejects,
# the shell silently runs it (silent-install, default on) and, failing
# that, degrades to its egui face with the missing-runtime warnings and
# Microsoft's official download link (warn-missing, default on). The lite
# flavor carries nothing — with download-url set (requires shun >= 0.6.5)
# its install step instead fetches the Evergreen bootstrapper from this
# permanent permalink and silently installs the runtime, so a lite
# install upgrades the machine over the network; the same silent-install
# knob gates carried and downloaded alike, and the banner announces it.
[webview2]
type = "evergreen-installer"
# Microsoft's Evergreen Bootstrapper (WebView2, evergreen lane): a few
# MB, always redirects to the latest runtime, and /silent /install is
# its documented contract.
download-url = "https://go.microsoft.com/fwlink/?linkid=2124701"

[install]
local = true
portable = true
# The wowsp app detects this marker beside its executable (paths.rs).
portable-marker = ".portable"
main-exe = "wowsp.exe"
# Shortcut conventions: both asked on the wizard's done page (default
# checked, the NSIS fresh-install convention), while headless runs
# resolve "ask" by PRESENCE — an existing launcher is refreshed in
# place, a missing one is not invented — so a silent auto-update never
# re-creates a desktop/start-menu entry the player deleted (that
# uninvited .lnk spray is exactly what Huorong/360 flag). Explicit
# --shortcut-* answers still win when an updater passes them.
desktop-shortcut = "ask"
start-menu-shortcut = "ask"
# Unattended updates self-heal: the silent flow stopped the running app on
# the overwrite, "always" puts it back (the GUI done page keeps its own
# checkbox — this knob only pins the headless lane).
launch-after-install = "always"
# %LOCALAPPDATA%\WoWSP is the app's model-pack cache root — installing
# there would churn the cache on every reinstall and endanger it on
# uninstall, so the per-user install lives one Programs level deeper.
default-dir = '%LOCALAPPDATA%\Programs\WoWSP'

# ── Install-location rules (shun >= 0.6.30 built-ins + dir-rules) ──────────
# shun 0.6.30 guards the install location three ways. Two are built-in
# defaults with no entry here: a bare drive-root target is refused
# outright (`forbid-drive-root`), and a FRESH install refuses a
# non-empty directory (`forbid-non-empty`, the OS junk list exempt) —
# delivering beside foreign files is exactly how an install ends up
# co-located with something its update swap / uninstall sweep would
# take away. Upgrades never re-answer their location (the never-strand
# rule), except through the rule below.
# The declarative rule IS the game-folder guard — the same
# identification set as the app's game_client.rs root stubs
# (WorldOfWarships.exe / Korabli.exe), replacing the check-dir.dk
# duckscript this manifest used to stage (its ten-locale branching now
# lives here as message-locales). action = "relocate": a fresh pick of
# such a folder is vetoed with the message below, and an install that
# already lives in one is RELOCATED instead of updated in place — the
# silent updater hands over to the wizard (`--relocate-from`), which
# opens on the location step, installs into a fresh folder, and then
# sweeps ONLY WoWSP's manifest-listed files out of the old one; the
# game folder and everything else in it survives untouched.
[[install.dir-rules]]
files = ["WorldOfWarships.exe", "Korabli.exe"]
action = "relocate"
message = "This looks like the World of Warships game folder — WoWSP must not install here: uninstalling WoWSP would delete the game itself. Pick a separate folder (for example D:/Programs/WoWSP)."

[install.dir-rules.message-locales]
zh-Hans = "检测到这是《战舰世界》游戏目录——WoWSP 不能安装在这里：卸载 WoWSP 时会把游戏本体一并删除。请选择一个单独的文件夹（例如 D:/Programs/WoWSP）。"
zh-Hant = "偵測到這是《戰艦世界》遊戲目錄——WoWSP 不能安裝在這裡：解除安裝 WoWSP 時會把遊戲本體一併刪除。請選擇一個單獨的資料夾（例如 D:/Programs/WoWSP）。"
ru = "Похоже, это папка игры «Мир кораблей» — устанавливать WoWSP сюда нельзя: удаление WoWSP удалит и саму игру. Выберите отдельную папку (например, D:/Programs/WoWSP)."
ja = "これは World of Warships のゲームフォルダのようです——ここに WoWSP をインストールしてはいけません。WoWSP をアンインストールするとゲーム本体も削除されてしまいます。別のフォルダーを選んでください（例: D:/Programs/WoWSP）。"
ko = "이 폴더는 World of Warships 게임 폴더로 보입니다——여기에 WoWSP를 설치하면 안 됩니다. WoWSP를 제거할 때 게임 본체까지 함께 삭제됩니다. 별도의 폴더를 선택해 주세요 (예: D:/Programs/WoWSP)."
fr = "Ce dossier semble être celui du jeu World of Warships — WoWSP ne doit pas s'y installer : le désinstaller supprimerait le jeu lui-même. Choisissez un dossier distinct (par exemple D:/Programs/WoWSP)."
es = "Esta carpeta parece ser la del juego World of Warships — WoWSP no debe instalarse aquí: al desinstalar WoWSP se borraría el propio juego. Elige una carpeta aparte (por ejemplo D:/Programs/WoWSP)."
de = "Dies scheint der Spielordner von World of Warships zu sein — WoWSP darf hier nicht installiert werden: Beim Deinstallieren von WoWSP würde das Spiel selbst mitgelöscht. Wähle einen eigenen Ordner (z. B. D:/Programs/WoWSP)."
