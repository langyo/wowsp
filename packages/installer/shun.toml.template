# WoWSP installer manifest — consumed by the shun CLI (`shun build`).
# Requires shun >= 0.6.28 (the silent upgrade retries its directory
# swap over a lock survivor and degrades to an in-place merge — the
# 0.6.1 → 0.6.2 stranding; v0.6.26 minimum for dir-less silent runs to
# upgrade the registered install in place; v0.6.25 minimum for the
# headless shortcut presence refresh).
#
# This file is a TEMPLATE: scripts/build_installers.py renders it into the
# staging tree (substituting __WOWSP_VERSION__ with the workspace version)
# next to the staged payloads and license documents, then invokes
# `shun build --manifest <stage>/shun.toml --variant lite|webview2` inside
# a shun checkout (see the script and packages/installer/README.md).
#
# Schema: shun's configuration guide (celestia-island/shun
# docs/en/guides/configuration.md). Everything the installer does is
# declared here — WoWSP ships no custom installer shell anymore.

# Standalone manifest shape (consumed by `shun build`; see shun's
# docs/en/guides/configuration.md): product identity is flat.
product = "WoWSP"
version = "__WOWSP_VERSION__"
publisher = "langyo"
# Caption-bar / window icon source, staged beside this manifest.
logo = "logo.webp"

# Each published artifact is one variant; the base payload exists only so
# `shun config` has a default (every build pins --variant).
payload = "payload-lite"

# The complete flavor carries the Evergreen offline runtime under its
# payload's webview2/ subtree: on a machine the WebView2 loader rejects,
# the shell silently runs it (silent-install, default on) and, failing
# that, degrades to its egui face with the missing-runtime warnings and
# Microsoft's official download link (warn-missing, default on). The lite
# flavor carries nothing — with download-url set (requires shun >= 0.6.5)
# its install step instead fetches the Evergreen bootstrapper from this
# permanent permalink and silently installs the runtime, so a lite
# install upgrades the machine over the network; the same silent-install
# knob gates carried and downloaded alike, and the banner announces it.
[webview2]
type = "evergreen-installer"
# Microsoft's Evergreen Bootstrapper (WebView2, evergreen lane): a few
# MB, always redirects to the latest runtime, and /silent /install is
# its documented contract.
download-url = "https://go.microsoft.com/fwlink/?linkid=2124701"

[install]
local = true
portable = true
# The wowsp app detects this marker beside its executable (paths.rs).
portable-marker = ".portable"
main-exe = "wowsp.exe"
# Shortcut conventions: both asked on the wizard's done page (default
# checked, the NSIS fresh-install convention), while headless runs
# resolve "ask" by PRESENCE — an existing launcher is refreshed in
# place, a missing one is not invented — so a silent auto-update never
# re-creates a desktop/start-menu entry the player deleted (that
# uninvited .lnk spray is exactly what Huorong/360 flag). Explicit
# --shortcut-* answers still win when an updater passes them.
desktop-shortcut = "ask"
start-menu-shortcut = "ask"
# Unattended updates self-heal: the silent flow stopped the running app on
# the overwrite, "always" puts it back (the GUI done page keeps its own
# checkbox — this knob only pins the headless lane).
launch-after-install = "always"
# %LOCALAPPDATA%\WoWSP is the app's model-pack cache root — installing
# there would churn the cache on every reinstall and endanger it on
# uninstall, so the per-user install lives one Programs level deeper.
default-dir = '%LOCALAPPDATA%\Programs\WoWSP'

# ── Wizard license documents (four docs, ten locales) ─────────────────────
# The agreement bodies are the vendored SySL translations (staged as
# licenses/<locale>.txt; the build refreshes them from celestia-island/sysl
# when the network allows), the copyright notices and telemetry pages are
# WoWSP's own (docs/<lang>/license/usage-telemetry.md staged as
# telemetry/<locale>.md; de/pt read the English page).

