# Rust
/target/
**/target/
**/*.rs.bk
# IDE
.idea/
.vscode/
.opencode/
.zed/
*.swp
*.swo
*~
*.bak
*.tmp

# Node.js
node_modules/
dist/
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.*.local

# Logs
*.log
/logs/
/tmp/

# Operating system
.DS_Store
Thumbs.db

# Test coverage
/coverage/
**/__pycache__/
# tauri-build schema/acl dumps (regenerated on every cargo build) stay
# ignored; the gen/android project sources ARE tracked (standard Tauri v2
# practice — its own gen/android/.gitignore excludes build outputs).
packages/app/tauri/gen/schemas/
packages/installer-shell/gen/
.cache/

# Python venvs
.venv/
scripts/mock/.venv/

# Tauri icons were generated from docs/logo.svg by scripts/ensure_tauri_icons.py
# (via `cargo tauri icon`) and are committed so CI can build without a
# tauri-cli install. Regenerate with `python scripts/ensure_tauri_icons.py`.

# Logo sync cache (generated by scripts/sync_logo.py)
packages/webui/src/res/.logo-source-hash

# Transpiled shaders (generated from res/shaders/**/*.glsl + *.theme.toml by scripts/glsl_bundle.py)
packages/webui/.generated/

# WoWSP runtime data (detected game paths, parsed replays cache)
.wowsp-cache/

# The ROOT Cargo.lock is tracked (reproducible resolution for CI and its
# hashFiles cache key). The standalone wasm workspace keeps its own
# gitignored lock via packages/pairing-relay/.gitignore; the vendored
# wowsunpack workspace's lock is ignored by its own .gitignore too.

# ZCode agent working dir
.zcode/

# Model conversion tool cache (downloaded by batch_bake.py)
/target/model-tools/
/target/model-tmp/

# Vendored wowsunpack (maintained by us, tracked in-tree)
# Build artifacts inside the vendor are still ignored via its own .gitignore
packages/tools/wowsunpack-vendor/target/

# celestia-devtools: staged-on-demand shared justfile recipes (celestia-devtools init / just fetch)
/.just/
/celestia-devtools.just

# Baked 3D model GLBs are distributed via the GitHub Release model pack
# (tag `res-latest`) and cached locally like node_modules — never tracked.
packages/webui/src/res/models/ships/*.glb
packages/webui/src/res/models/planes/*.glb
packages/webui/src/res/models/props/*.glb
packages/webui/src/res/models/maps/*.glb

# res-latest manifest persisted by scripts/fetch_models.py — derived download
# like the GLBs (rides publicDir into dist for the mobile bundle baseline).
packages/webui/src/res/wowsp-res.json

# Offline GameParams ship-data pack (scripts/extract_gameparams.py) — derived
# from a local game extract like the GLB pack; the android build regenerates
# it before the webui build and desktop builds prune it from dist.
packages/webui/src/res/data/gameparams/

# The pack's refreshed dog-tag map, extracted by fetch_models.py over the
# tracked snapshot baked into src/data/dogtags_map.json at build time.
packages/webui/src/res/dogtags/dogtags_map.json

# WebView2 Evergreen offline installer cached by scripts/build_installers.py
# (~180 MB, never tracked) for the -webview2.zip delivery artifact.
packages/installer-shell/vendor/
installer-shell/vendor/

# Baked ship portraits (scripts/extract/download_ship_images.py) — derived
# from the WG CDN like the model pack; regenerated at packaging time.
packages/webui/src/res/images/ships/[0-9]*.png
packages/webui/src/res/images/ships/_index.json

# Local release staging (installers are uploaded to GitHub Releases)
dist-release/
node_modules
