# Operating system
.DS_Store
Thumbs.db

# Test coverage
/coverage/
**/__pycache__/
packages/app/tauri/gen/
.cache/

# Python venvs
.venv/
scripts/mock/.venv/

# Tauri icons were generated from docs/logo.svg by scripts/ensure_tauri_icons.py
# (via `cargo tauri icon`) and are committed so CI can build without a
# tauri-cli install. Regenerate with `python scripts/ensure_tauri_icons.py`.

# Logo sync cache (generated by scripts/sync_logo.py)
packages/webui/src/res/.logo-source-hash

# Transpiled shaders (generated from res/shaders/**/*.glsl + *.theme.toml by scripts/glsl_bundle.py)
packages/webui/.generated/

# WoWSP runtime data (detected game paths, parsed replays cache)
.wowsp-cache/

# Cargo lockfile (generated, not tracked)
Cargo.lock

# ZCode agent working dir
.zcode/

# Model conversion tool cache (downloaded by batch_bake.py)
/target/model-tools/
/target/model-tmp/

# Vendored wowsunpack (maintained by us, tracked in-tree)
# Build artifacts inside the vendor are still ignored via its own .gitignore
packages/tools/wowsunpack-vendor/target/

# celestia-devtools: staged-on-demand shared justfile recipes (celestia-devtools init / just fetch)
/.just/
/celestia-devtools.just
