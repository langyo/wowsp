  "typeInfo": {
    "bb": {
      "title": "战列舰",
      "body": "重炮厚甲的主力舰：主炮口径与单发伤害最高，代价是装填慢、转舵与起步都迟钝。摆出正面对敌的角度让 AP 弹跳开，把炮弹砸向敌舰侧舷中段的核心区才有满伤害，HE 弹则用来点火、啃摆角目标。多数战列舰没有鱼雷和烟雾，一旦被点亮集火就很难受，驱逐舰的雷击更是致命。"
    },
    "cv": {
      "title": "航空母舰",
      "body": "航母的输出来自舰载机而非自身火炮：机队数量有限，被防空打光就再无输出，所以要打了就走。母舰本体几乎没有自卫火力，靠距离与地形活命，真正的价值是侦察与全图支援。",
      "keys": {
        "1": {
          "key": "数字键",
          "text": "点选不同数字起飞不同类型的飞机，双击直接放飞。"
        },
        "2": {
          "key": "左键",
          "text": "进入攻击航线，再按一次投下弹药。"
        },
        "3": {
          "key": "W",
          "text": "引擎加速（会过热，注意间歇使用）。"
        },
        "4": {
          "key": "F",
          "text": "召回机队。"
        }
      }
    },
    "ca": {
      "title": "重型巡洋舰",
      "body": "以 203 mm 级重炮为核心的大型巡洋舰：单发伤害高，AP 能打穿多数巡洋舰的装甲，通常还带雷达或水听来抢情报。比轻巡抗揍，但近战仍有致命的核心区，所以要在射程边缘“放风筝”，趁敌人装填的空档输出。"
    },
    "cl": {
      "title": "轻型巡洋舰",
      "body": "以 152 mm 级速射炮为主的轻巡：靠射速与 HE 弹堆出极高的每分钟伤害，常带烟雾、水听与不错的隐蔽。装甲薄、核心区浅，近身对炮极易被打穿，要贴着地形和烟雾打游击；面对硬目标则靠点火与鱼雷补伤害。"
    },
    "cruiser": {
      "title": "巡洋舰",
      "body": "介于驱逐舰与战列舰之间的多面手：重巡（CA）牺牲射速换单发威力，轻巡（CL）牺牲威力换投射量。多数带雷达或水听，是队伍的眼睛、驱逐杀手与防空掩护；共同弱点是装甲薄，挨上一轮战列舰齐射就可能重伤。"
    },
    "dd": {
      "title": "驱逐舰",
      "body": "高隐蔽的近距离杀手：船体小、隐蔽 5–7 km，用鱼雷偷袭大船、用烟雾脱身。驱逐舰是队伍的眼睛，负责点亮、占点与争夺，也是最怕暴露的舰种：装甲薄、续航差，被雷达照到就失去赖以生存的隐蔽。"
    },
    "ss": {
      "title": "潜艇",
      "body": "水下刺客：艏艉鱼雷发射管是主要武器，多数为声呐制导鱼雷——先用声呐脉冲标记目标再发射，鱼雷会追着标记走，第二次脉冲会强化追踪并延长标记时间。",
      "keys": {
        "1": {
          "key": "C",
          "text": "下潜：最大深度只剩制导鱼雷，自身视野几乎归零，只能靠队友点亮。"
        },
        "2": {
          "key": "F",
          "text": "上浮：水面与潜望镜深度还能用甲板炮与普通鱼雷。"
        },
        "3": {
          "key": "G",
          "text": "解除已发出的声呐标记。"
        }
      },
      "note": "下潜消耗电池，水面回充。水下被击中会让燃油系统受损：约 5 秒内上浮或交损管即可止住，否则漏油会持续暴露位置，直到你上浮。"
    }
  },
