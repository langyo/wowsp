{
  "name": "@wowsp/root",
  "version": "0.6.6",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "description": "World of WarShip Panel — replay review & in-game overlay",
  "scripts": {
    "dev": "pnpm --filter @wowsp/webui dev",
    "build": "pnpm --filter @wowsp/webui build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "rm -rf node_modules",
    "site:dev": "pnpm --filter @wowsp/website dev",
    "site:build": "pnpm --filter @wowsp/website build"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4",
    "@types/three": "^0.185",
    "@unocss/preset-wind": "^66",
    "oxlint": "^1",
    "sass": "^1",
    "unocss": "^66"
  }
}
